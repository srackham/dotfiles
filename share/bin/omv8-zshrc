# vim: set filetype=zsh:

# Custom prompt
export PROMPT=$'\n%B%F{red}%n@%m %F{cyan}%~%f%b\n$ '

export PATH=$HOME/bin:$PATH

# Common aliases
alias ..='cd ..'
alias ...='cd ../..'

# alias ls='ls --color=auto'
# alias ll='ls --color=auto -Al'
# alias lr='ls --color=auto -Altr'

alias ls="eza"
alias ll="eza -l --icons  -a"
alias lr="eza -l --icons  -as modified"
alias lt="eza --tree --long --icons"
alias td="eza --tree --only-dirs --icons"
alias tr="eza --tree --icons"
alias tg="eza --tree --icons --git-ignore"

alias g='grep -i'
alias h='fc -l 1'
alias l="batcat --plain"

# Command-line history
HISTSIZE=200000
SAVEHIST=200000
HISTFILE=~/.zsh_history

setopt hist_ignore_all_dups   		  # Remove duplicate commands
setopt interactive_comments  		  # comments in shell; good for copy/paste

# zsh native command recall
bindkey -v                            # vi command-line editing
bindkey -M viins '^R' history-incremental-pattern-search-backward
bindkey -M vicmd '^R' history-incremental-pattern-search-backward
bindkey -M viins '^F' history-incremental-pattern-search-forward
bindkey -M vicmd '^F' history-incremental-pattern-search-forward
bindkey -M viins '^N' down-line-or-history
bindkey -M vicmd '^N' down-line-or-history
bindkey -M viins '^P' up-line-or-history
bindkey -M vicmd '^P' up-line-or-history

# zsh help command for builtin commands
autoload -Uz run-help; alias help=run-help

# Enable completion system
autoload -Uz compinit && compinit

# Basic, useful completion behaviour
zstyle ':completion:*' completer _complete _ignored _files
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' special-dirs true
zstyle ':completion:*' rehash true
zstyle ':completion::complete:*' use-cache true

# For SSH windows change the window tab name to the machine host name
if [[ -n "$SSH_CONNECTION" ]]; then
    print -Pn '\e]0;%m\a'
fi

# Highlight valid paths
source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
export ZSH_HIGHLIGHT_STYLES[path]='fg=cyan,underline'
export ZSH_HIGHLIGHT_STYLES[path_prefix]='fg=cyan,underline'
export ZSH_HIGHLIGHT_STYLES[path_pathseparator]='fg=cyan,underline'
